# Modelo para client/.env (desarrollo local). Para producción se usa client/.env.production.
#
# true = mostrar los bloques de anuncio (en desarrollo, sin ID se ve un recuadro de referencia).
VITE_ADS_ENABLED=false
#
# IDs de bloques de anuncio de AdSense (Anuncios → Por bloque de anuncios → "Anuncio de display"):
#   el número de data-ad-slot="..." del código que te da Google (10 dígitos, no el ca-pub-...).
VITE_ADSENSE_SLOT_FOOTER=
VITE_ADSENSE_SLOT_GAME=
