# IDs públicos de bloques de anuncio de AdSense (se usan al compilar para producción, ej. en Railway).
# No son secretos: Google los publica en el HTML de la página.
# Una variable del mismo nombre cargada en Railway tiene prioridad sobre este archivo.
#
# Interruptor de anuncios: apagados mientras AdSense revisa el sitio. Poné true cuando lo aprueben.
VITE_ADS_ENABLED=false
#
# ID de bloque = el número de data-ad-slot="..." (10 dígitos). NO es el ID de editor (ca-pub-...).
VITE_ADSENSE_SLOT_FOOTER=4696068025
# Pendiente: crear el bloque del juego en AdSense y pegar acá su data-ad-slot.
VITE_ADSENSE_SLOT_GAME=
